APP_NAME=Afrishop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://afrishop.bf
APP_TIMEZONE=UTC
APP_LOCALE=fr

# ---------------------------------------------------------------------
# Base de données — MySQL 8.0+ ou MariaDB 10.6+
# La base DOIT être créée en utf8mb4 / utf8mb4_unicode_ci :
#   CREATE DATABASE afrishop CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# utf8mb3 casserait les emojis utilisés comme visuels de repli produit.
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afrishop
DB_USERNAME=afrishop
DB_PASSWORD=

# ---------------------------------------------------------------------
# Prestataire de paiement (PSP)
# Le PSP encaisse le client, garde les fonds en séquestre sur le
# sous-compte de chaque boutique, puis exécute les virements sur ordre.
# ---------------------------------------------------------------------
PSP_DRIVER=cinetpay          # cinetpay | paydunya | flutterwave | fake
PSP_API_KEY=
PSP_SITE_ID=
PSP_SECRET=
PSP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# SMS — porte le code de livraison à usage unique
# Sans envoi de SMS, le client ne reçoit pas son code, le livreur ne
# peut pas faire valider la livraison, et les fonds ne sont pas libérés.
#
# journal = n'envoie rien, écrit dans les logs (développement)
# orange  = API SMS Burkina Faso — https://developer.orange.com/apis/sms-bf
#
# Tarifs Orange (paquets, à recharger) : 1 000 SMS = 8 000 F (8 F pièce),
# 100 SMS = 900 F en offre de démarrage, utilisable une seule fois.
# ATTENTION : les paquets EXPIRENT (30 jours pour le Silver).
# ---------------------------------------------------------------------
SMS_DRIVER=journal           # journal | orange
SMS_ORANGE_CLIENT_ID=
SMS_ORANGE_CLIENT_SECRET=
# Numéro émetteur fourni par Orange, format international.
SMS_ORANGE_ADRESSE=+226
# Nom affiché au destinataire — 11 caractères alphanumériques maximum,
# à faire valider par Orange (formulaire en ligne).
SMS_NOM_EXPEDITEUR=AFRISHOP
# Coût d'un segment, d'après le paquet acheté. Sert au suivi mensuel.
SMS_COUT_UNITAIRE_CFA=8

# ---------------------------------------------------------------------
# Règles métier — modifiables sans toucher au code
# ---------------------------------------------------------------------
# Délai après lequel une livraison non contestée est réputée acceptée
# et les fonds sont automatiquement débloqués (en jours).
AFRISHOP_DELAI_CONFIRMATION_AUTO=3
# Commission par défaut appliquée à une nouvelle boutique (%).
AFRISHOP_COMMISSION_DEFAUT=10
# Sel utilisé pour hacher les IP des scans QR. À NE JAMAIS CHANGER une
# fois en production : les anciens hachages deviendraient incomparables.
AFRISHOP_SEL_SCAN=
# URL de base encodée dans les QR codes.
AFRISHOP_URL_VERIFICATION=https://afrishop.bf/v
