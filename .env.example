APP_NAME=Afrishop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://afrishop.bf
APP_TIMEZONE=UTC
APP_LOCALE=fr

# ---------------------------------------------------------------------
# Base de données — MySQL 8.0+ ou MariaDB 10.6+
# La base DOIT être créée en utf8mb4 / utf8mb4_unicode_ci :
#   CREATE DATABASE afrishop CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# utf8mb3 casserait les emojis utilisés comme visuels de repli produit.
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afrishop
DB_USERNAME=afrishop
DB_PASSWORD=

# ---------------------------------------------------------------------
# Prestataire de paiement (PSP)
# Le PSP encaisse le client, garde les fonds en séquestre sur le
# sous-compte de chaque boutique, puis exécute les virements sur ordre.
# ---------------------------------------------------------------------
# ---------------------------------------------------------------------
# Autorités de certification (appels HTTPS sortants)
# ---------------------------------------------------------------------
# PHP sous Windows n'embarque aucune liste d'autorités : sans elle,
# TOUT appel sortant échoue avec « cURL error 60 — unable to get local
# issuer certificate », et aucun paiement ne peut être lancé.
# Le paquet est versionné dans storage/certs/cacert.pem et utilisé par
# défaut. Laisser cette ligne ABSENTE sur un poste Windows.
#
# Sur un serveur Linux dont le magasin système est à jour, mettre la
# valeur VIDE ci-dessous pour rendre la main au système — c'est
# préférable, un fichier versionné finissant par vieillir.
# CA_BUNDLE=

# « fake » encaisse tout instantanément : c'est le driver de
# développement. Ne le laisser en production sous AUCUN prétexte — il
# marquerait chaque commande comme payée sans qu'un franc n'entre.
PSP_DRIVER=fake              # fake | paydunya | cinetpay

# --- CinetPay -------------------------------------------------------
# Les trois valeurs viennent du tableau de bord marchand CinetPay.
#
# CINETPAY_SECRET_KEY sert à vérifier la signature des notifications.
# Si elle manque, TOUTES les notifications sont rejetées et aucun
# paiement n'est jamais confirmé — la panne est silencieuse côté client,
# qui a bien payé et voit sa commande rester « en attente ».
#
# ATTENTION EN LOCAL : CinetPay doit joindre notify_url depuis Internet.
# 127.0.0.1 ne lui dit rien. Pour tester sur votre poste, exposez le
# site par un tunnel (ngrok, cloudflared) et mettez l'adresse publique
# dans APP_URL — c'est elle qui construit notify_url.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_CANAUX=ALL          # ALL | MOBILE_MONEY | CREDIT_CARD | WALLET

# --- PayDunya -------------------------------------------------------
# CELUI-CI EST TESTABLE TOUT DE SUITE. Inscription sur paydunya.com,
# création d'une application, puis onglet « Mode Test » : on obtient
# trois clés de test et une page de paiement fictive. Toute la chaîne —
# paiement, notification, grand livre, séquestre — se vérifie sans
# engagement et sans qu'un franc bouge.
#
# Passage en production : PAYDUNYA_MODE=live + les clés de production.
# Rien d'autre ne change.
#
# En mode test, PAYDUNYA_PRIVATE_KEY commence par « test_ ». Mélanger
# une clé de test et le mode live donne un refus d'authentification —
# bruyant, donc sans danger.
PAYDUNYA_MODE=test           # test | live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_NOM_BOUTIQUE=Afrishop

# ATTENTION — VALABLE POUR LES DEUX PRESTATAIRES :
# la notification est envoyée par leurs serveurs vers APP_URL.
# 127.0.0.1 ne leur dit rien : en local, aucune notification n'arrivera.
# Pour tester le circuit complet, exposez le site par un tunnel
# (ngrok, cloudflared) et mettez l'adresse publique dans APP_URL.

PSP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# SMS — porte le code de livraison à usage unique
# Sans envoi de SMS, le client ne reçoit pas son code, le livreur ne
# peut pas faire valider la livraison, et les fonds ne sont pas libérés.
#
# journal = n'envoie rien, écrit dans les logs (développement)
# orange  = API SMS Burkina Faso — https://developer.orange.com/apis/sms-bf
#
# Tarifs Orange (paquets, à recharger) : 1 000 SMS = 8 000 F (8 F pièce),
# 100 SMS = 900 F en offre de démarrage, utilisable une seule fois.
# ATTENTION : les paquets EXPIRENT (30 jours pour le Silver).
# ---------------------------------------------------------------------
SMS_DRIVER=journal           # journal | orange
SMS_ORANGE_CLIENT_ID=
SMS_ORANGE_CLIENT_SECRET=
# Numéro émetteur fourni par Orange, format international.
SMS_ORANGE_ADRESSE=+226
# Nom affiché au destinataire — 11 caractères alphanumériques maximum,
# à faire valider par Orange (formulaire en ligne).
SMS_NOM_EXPEDITEUR=AFRISHOP
# Coût d'un segment, d'après le paquet acheté. Sert au suivi mensuel.
SMS_COUT_UNITAIRE_CFA=8

# ---------------------------------------------------------------------
# Règles métier — modifiables sans toucher au code
# ---------------------------------------------------------------------
# Délai après lequel une livraison non contestée est réputée acceptée
# et les fonds sont automatiquement débloqués (en jours).
AFRISHOP_DELAI_CONFIRMATION_AUTO=3
# Commission par défaut appliquée à une nouvelle boutique (%).
AFRISHOP_COMMISSION_DEFAUT=10
# Sel utilisé pour hacher les IP des scans QR. À NE JAMAIS CHANGER une
# fois en production : les anciens hachages deviendraient incomparables.
AFRISHOP_SEL_SCAN=
# URL de base encodée dans les QR codes.
AFRISHOP_URL_VERIFICATION=https://afrishop.bf/v

# Service client — affiché aux clients, vendeurs et livreurs
SUPPORT_TELEPHONE=+22676921202
